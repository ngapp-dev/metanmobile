<!-- No updatePeriodMillis: the widget only shows the app's local data, so it is re-rendered when
     that data changes (WidgetPublisher in :widget:core) instead of on a timer.
     Down to one tile (minResizeWidth, ~2 cells), up to the full screen width; the content
     switches between one and two tiles with the size (NearestStationWidgetLayout).
     Appearance settings: optional on add (defaults apply), reachable later from the launcher.
     Height is one row (minHeight 40dp = one cell on pre-12 launchers, 70 * n - 30). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ngapp.metanmobile.widget.nearest.station.settings.NearestStationWidgetSettingsActivity"
    android:description="@string/widget_nearest_station_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
