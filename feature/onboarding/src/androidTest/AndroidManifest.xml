<!--
  Test-only manifest for this module's instrumented test APK. The Mobile Ads SDK's own manifest
  self-registers MobileAdsInitProvider regardless of which app pulls it in transitively, and that
  provider crashes on process attach unless a com.google.android.gms.ads.APPLICATION_ID meta-data
  is present. The real app supplies its real one (see app/src/main/AndroidManifest.xml); when this
  module's androidTest APK is built and installed standalone (not merged into the real app), that
  meta-data is missing unless declared here too. This is Google's published, public test AdMob App
  ID (see https://developers.google.com/admob/android/test-ads) - not a secret, and never shipped
  in the real app, only in this test APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
